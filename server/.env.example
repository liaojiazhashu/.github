# ============================================================
# 银河图书馆 · 环境变量模板
# 复制为 .env 后填入真实值；.env 已在 .gitignore，禁止提交
#
# 生成口令：D:\webserver\php\php.exe -r "echo bin2hex(random_bytes(24));"
# 生成 KEK：D:\webserver\php\php.exe -r "echo base64_encode(random_bytes(32));"
# ============================================================

# 银河图书馆 · 本地环境（不要提交到版本库）
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8090
APP_TIMEZONE=Asia/Shanghai
APP_KEK=

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hqlib
DB_USER=hqlib_app
DB_PASS=
DB_CHARSET=utf8mb4

# ---- DeepSeek 官方（2026-10-28 实测：仅 deepseek-flash / deepseek-v4-pro 两个模型）----
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_MODEL_HEAVY=deepseek-v4-pro
# effort 是成本开关：low 思考量约为默认档的 1/4、耗时约 1/3（实测同任务 645 vs 2463 reasoning tokens）
# 机械抽取阶段（索引词/伏笔清单）用 low；需要判断的阶段（剧情/建议/修改方向）用 high
AI_EFFORT_CHEAP=low
AI_EFFORT_DEEP=high
# 两个模型都是思考型：max_tokens 必须覆盖 reasoning 后再留输出余量，
# 实测 reasoning 可占输出的 60–80%，给小了会返回空 content 且 finish_reason=length
AI_MAX_OUTPUT_TOKENS=32000
AI_TEMPERATURE=0.2
AI_TIMEOUT=300
AI_CONNECT_TIMEOUT=15
# 每阶段最多尝试次数（空 content / length / 429 / 5xx 都算可重试）
AI_RETRY_MAX=3
# 单篇预算熔断：实测一篇约 0.19 元（3 万字 6 阶段，高峰价），3 元是 15 倍余量，防病态重试
AI_MAX_CONCURRENCY=2
AI_DAILY_BUDGET_YUAN=100
AI_PER_WORK_BUDGET_YUAN=3
DEEPSEEK_API_KEY=

SESSION_NAME=hq_admin
SESSION_LIFETIME=1800
LOG_LEVEL=info

# ---- 公开馆藏（M5）----
# 方法说明页（静态站 library.html）。同域填 /library.html，分端口填绝对地址
LIBRARY_METHOD_URL=/library.html
LIBRARY_PER_PAGE=12

# ---- 备份与恢复演练（M6）----
# 备份目录留空用默认 server/storage/backups；这里别写 POSIX 路径（/d/…），
# open_basedir 只认盘符路径，is_dir 会直接抛异常
# BACKUP_DIR=
BACKUP_KEEP=7
# 演练库是独立的：应用账号对它没有任何权限，这个账号只有 hqlib_drill 的权限
DRILL_DB_HOST=127.0.0.1
DRILL_DB_PORT=3307
DRILL_DB_NAME=hqlib_drill
DRILL_DB_USER=hqlib_restore
DRILL_DB_PASS=

# ---- 告警通道（M6 / E-67）----
# 上线时把这两行填上就是「告警通电」：代码侧不需要改。
# 未填时 Alert 仍会往 storage/logs/alert.log 落一行 skipped —— 留着痕才分得清
# 是「没配」还是「配了但发不出去」。
# webhook 只接受运维填的固定地址，不接受任何用户输入（与 E-47/E-49 同一条约束）
ALERT_ENABLED=false
ALERT_WEBHOOK=
ALERT_TIMEOUT=3
# 同一个标题的冷却秒数：健康检查每分钟一次，不去重会刷屏
ALERT_COOLDOWN=1800
