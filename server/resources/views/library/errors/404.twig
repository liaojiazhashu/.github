{% extends 'library/layout.twig' %}

{% block content %}
<section class="pagehead pagehead--tall">
  <div class="wrap">
    <div class="eyebrow">{{ code|default('404') }}</div>
    <h1 class="h1">{{ heading|default('没有这一页') }}</h1>
    <p class="lede">{{ message }}</p>
    <div class="ctaband__acts">
      <a class="btn btn--primary" href="/library/works">去看馆藏</a>
      <a class="btn" href="/library/terms">按词找</a>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="hotwords">
    <div class="hotwords__l">或者从这些词条进去</div>
    <div class="chips">
      {% for t in hot_terms|default([]) %}
        <a class="chip chip--lg" href="/library/terms/{{ t.id }}">{{ t.canonical }}<i class="mono">{{ t.works }}</i></a>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
