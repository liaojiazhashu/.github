{
    "name": "huangqi/library-platform",
    "description": "银河图书馆动态化系统 · 荒启科幻板块三",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "twig/twig": "^3.14",
        "monolog/monolog": "^3.9",
        "ezyang/htmlpurifier": "^4.18",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirrors.aliyun.com/composer/",
            "canonical": false
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "allow-plugins": false
    },
    "scripts": {
        "serve": "@php -c php.ini -S 127.0.0.1:8090 -t public public/index.php",
        "test": "@php -c php.ini vendor/bin/phpunit"
    }
}
